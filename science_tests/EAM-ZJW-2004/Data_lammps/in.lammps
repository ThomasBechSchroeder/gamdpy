units			metal
atom_style		atomic
boundary		p p p

# Create box manually before calling read_dump
region	     	      simbox block -1.444132e+01 1.444132e+01 -1.444132e+01 1.444132e+01 -1.444132e+01 1.444132e+01
create_box	      1 simbox


# Read atomic configuration from dump file
read_dump     		    Cu-liquid-rho0.0850-T0.2154.lammps 0 x y z ix iy iz vx vy vz fx fy fz box yes add yes

variable natoms equal atoms
print "Read ${natoms} atoms from dump"

#pair_style		    eam
#pair_coeff		    * * Cu_u3.eam

pair_style		    eam/alloy
pair_coeff		    * * Cu_Zhou04.eam.alloy Cu


# Set mass for Copper (atomic number 29)
mass  	       	      	      1 63.546

# Time integration
variable time_unit_as_ps equal 0.010180505717871194
variable dt_natural equal 0.1
variable dt equal ${dt_natural}*${time_unit_as_ps}
variable tau_relax equal 10.0*${time_unit_as_ps}

timestep			${dt}
#fix				1 all nvt temp 2500 2500 ${tau_relax}
fix				1 all nve


compute myPressure all pressure thermo_temp

# Output settings
thermo			4
thermo_style		custom step temp pe ke etotal press pxx pyy pzz pyz pxz pxy

dump			1 all atom 100 dump.cu.run.lammpstrj
run			2048

