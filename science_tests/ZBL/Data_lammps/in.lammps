# Cu using the universal ZBL potential

units           metal
dimension       3
boundary        p p p
atom_style      atomic

lattice         fcc 4.2  # Å
region          box block 0 10 0 10 0 10 units lattice
create_box      1 box
create_atoms    1 box

mass            1 63.546  # grams/mole

neighbor        2.0 bin
neigh_modify    delay 1 every 1 check yes

pair_style      zbl 8.0 10.0
pair_coeff      * * 29.0 29.0

timestep        0.004  # picoseconds
velocity        all create 7000.0 2025 mom yes rot yes dist gaussian

thermo          40
thermo_style    custom step temp press pe ke etotal density # eV

# dump            1 all custom 2000 dump.lammpstrj id type x y z

#fix             1 all nve
#fix             2 all langevin 3500.0 3500.0 0.1 2025
fix              1 all nvt temp 3500.0 3500.0 0.1

run             32768
